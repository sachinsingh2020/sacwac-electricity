# Salesforce External Client App (OAuth 2.0 Client Credentials Flow)
# If your org has a My Domain, set SALESFORCE_LOGIN_URL to https://<your-domain>.my.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your_external_client_app_client_id
SALESFORCE_CLIENT_SECRET=your_external_client_app_client_secret

# Cloudinary (for storing meter reading photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Electricity Price Per Unit (Currency)
NEXT_PUBLIC_DEFAULT_RATE=10.00
